PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sems_uptm

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application, Authorized JavaScript origin = FRONTEND_URL above).
# Only the Client ID is needed — this flow verifies ID tokens, no client secret.
GOOGLE_CLIENT_ID=

# Sends the 6-digit OTP codes (signup verification, password reset, email
# change). GMAIL_APP_PASSWORD is a 16-character App Password generated at
# myaccount.google.com/apppasswords (requires 2-Step Verification on the
# Gmail account) — NOT the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Online / UAT settings. start-uat.bat sets these for you; they are listed here
# so you know what they do. Leave them out for normal local development.
# ---------------------------------------------------------------------------
# Serve the built frontend (frontend/dist) from this server. Automatic when
# NODE_ENV=production and a build exists.
# SERVE_FRONTEND=true
# Read the visitor's real IP from X-Forwarded-For (needed behind a tunnel or
# reverse proxy). "loopback" trusts a proxy on this same computer.
# TRUST_PROXY=loopback
# Adds upgrade-insecure-requests: only when the site is served over HTTPS.
# HTTPS_ONLY=true
# Per-IP limits per 15 minutes (defaults 10 / 10 / 300). Raise them when many
# testers share one public IP, for example a classroom or campus WiFi.
# LOGIN_RATE_MAX=40
# OTP_RATE_MAX=40
# GLOBAL_RATE_MAX=3000
